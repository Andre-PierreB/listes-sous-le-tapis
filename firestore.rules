rules_version = '2';
// Règles d'accès de Sous le tapis (Firestore). À coller dans la console
// Firebase : Firestore → onglet « Règles » → Publier.
//   lists/<id>    : une liste, lisible et modifiable par ses membres (members) ;
//                   seul son créateur (owner) peut changer les membres, les noms
//                   ou la supprimer. Un invité ne peut faire disparaître aucune
//                   tâche : une tâche effacée reste dans la liste, marquée
//                   « effacée » (10.2).
//   users/<uid>   : la fiche « moi » de chaque compte, privée.
//   invites/<code>: une invitation par lien (10.2) — créée par qui invite,
//                   acceptée une seule fois par quelqu'un d'autre, effacée
//                   ensuite par qui a invité.
//   essai_…       : les mêmes, pour la page d'essai (essai.html).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // nombre de places de tâches d'une liste (tâches + places gardées de côté)
    function slots(d) { return d.get('items', []).size() + d.get('ghosts', []).size(); }

    function canReadList() {
      // resource == null : la liste n'existe pas encore (lecture avant création)
      return signedIn() && (resource == null || request.auth.uid in resource.data.members);
    }
    function canCreateList() {
      return signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.auth.uid in request.resource.data.members;
    }
    // un invité : ni les membres, ni les noms, ni la suppression de la liste,
    // et le nombre de tâches ne diminue jamais
    function guestChangeOk() {
      return request.resource.data.members == resource.data.members
        && request.resource.data.get('names', null) == resource.data.get('names', null)
        && request.resource.data.get('deleted', null) == resource.data.get('deleted', null)
        && slots(request.resource.data) >= slots(resource.data);
    }
    function canUpdateList() {
      return signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.owner == resource.data.owner
        && (request.auth.uid == resource.data.owner || guestChangeOk());
    }
    function canDeleteList() { return signedIn() && request.auth.uid == resource.data.owner; }

    function canCreateInvite() {
      return signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'createdAt'])
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() <= 30;
    }
    function canAcceptInvite() {
      return signedIn()
        && !('usedBy' in resource.data)
        && resource.data.from != request.auth.uid
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedByName', 'usedAt'])
        && request.resource.data.usedByName is string
        && request.resource.data.usedByName.size() <= 30;
    }

    match /lists/{listId} {
      allow read: if canReadList();
      allow create: if canCreateList();
      allow update: if canUpdateList();
      allow delete: if canDeleteList();
    }
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.from == request.auth.uid;
      allow create: if canCreateInvite();
      allow update: if canAcceptInvite();
      allow delete: if signedIn() && resource.data.from == request.auth.uid;
    }

    match /essai_lists/{listId} {
      allow read: if canReadList();
      allow create: if canCreateList();
      allow update: if canUpdateList();
      allow delete: if canDeleteList();
    }
    match /essai_users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /essai_invites/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.from == request.auth.uid;
      allow create: if canCreateInvite();
      allow update: if canAcceptInvite();
      allow delete: if signedIn() && resource.data.from == request.auth.uid;
    }
  }
}
